APP_ENV=development
APP_NAME=self-rag-knowledge-chat
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/selfrag
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/selfrag

CLERK_ISSUER=https://<your-tenant>.clerk.accounts.dev
CLERK_JWKS_URL=https://<your-tenant>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX_NAME=self-rag-knowledge-chat
PINECONE_REGION=us-east-1
PINECONE_HOST=

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=2560
VECTOR_INDEX_BACKEND=pinecone
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=self-rag-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
MODEL_PRICING_CONFIG=backend/config/model_pricing.yaml
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=120
REQUEST_BODY_LIMIT_BYTES=2097152

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INGESTION_BATCH_SIZE=32
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BACKOFF_SECONDS=5
UPLOAD_MAX_MB=15
INGESTION_STORAGE_DIR=data/uploads
CHAT_STREAM_HEARTBEAT_INTERVAL_MS=10000
