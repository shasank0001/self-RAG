# Core app
APP_ENV=development
APP_NAME=self-rag-knowledge-chat
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/selfrag
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/selfrag

# Auth (Clerk + Svix)
CLERK_ISSUER=https://your-clerk-domain
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Vector DB
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX_NAME=self-rag-knowledge-chat
PINECONE_REGION=us-east-1
PINECONE_HOST=

# LLM Providers
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
